{
	"_comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
	"_copyright": "SPDX-FileCopyrightText: 2025 Seventeen Sierra LLC",
	"name": "ai-chats-root",
	"version": "0.1.0",
	"private": true,
	"description": "AI Chats - Monorepo Root",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@10.27.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"dev:all": "concurrently \"podman run --rm --name ai-chats-ollama -p 11434:11434 -v ollama_data:/root/.ollama ollama/ollama:latest\" \"pnpm -r --parallel run dev\" --names \"AI,WEB\" -c \"yellow,blue\"",
		"build": "pnpm -r run build",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test",
		"typecheck": "pnpm -r run typecheck",
		"check-license": "./scripts/check-license-headers.sh",
		"prepare": "husky"
	},
	"pnpm": {
		"overrides": {
			"ai": ">=6.0.0"
		},
		"supportedArchitectures": {
			"os": [
				"linux",
				"darwin"
			],
			"cpu": [
				"x64",
				"arm64"
			]
		},
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"sharp",
			"prisma"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^20.3.0",
		"@commitlint/config-conventional": "^20.3.0",
		"@playwright/test": "^1.57.0",
		"concurrently": "^9.1.2",
		"husky": "^9.1.7",
		"vitest": "^4.0.16"
	}
}
