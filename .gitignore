# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.template

# firebase
firebase-debug.log
firestore-debug.log
# Security audit artifacts
.sbom/
.trivy-cache/

# Python virtual environment (for semgrep)
.venv/

# Seed data (contains user chat exports with potentially sensitive content)
seed-data/*
!seed-data/README.md
!seed-data/LICENSE
!seed-data/package.json
!seed-data/tsconfig.json
.git-filter-repo-replacements

