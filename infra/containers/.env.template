# Gemini Oracle Environment Variables Template
# Copy this to .env (git ignored) and fill in secrets

# Database
DB_NAME=gemini_oracle
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5433

# Storage (Garage/S3)
S3_ACCESS_KEY=PLACEHOLDER_ACCESS_KEY
S3_SECRET_KEY=PLACEHOLDER_SECRET_REMOVED
S3_BUCKET_NAME=conversations

# Next.js
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development
